{
  "compilerOptions": {
    "types": [
      "@types/gtag.js" // 추가
    ],
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/components/common/*"],
      "@home/*": ["src/components/home/*"],
      "@about/*": ["src/components/about/*"],
      "@gallery/*": ["src/components/gallery/*"],
      "@blog/*": ["src/components/blog/*"],
      "@project/*": ["src/components/project/*"],
      "@signup/*": ["src/components/signup/*"],
      "@login/*": ["src/components/login/*"],
      "@mypage/*": ["src/components/mypage/*"],
      "@pages/*": ["src/pages/*"],
      "@styles/*": ["src/styles/*"],
      "@@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@utils": ["src/utils"],
      "@image/*": ["public/image/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "mp4.d.ts"],
  "exclude": ["node_modules"]
}
